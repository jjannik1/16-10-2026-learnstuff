<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="550.0" prefWidth="800.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.javafx_mvc.HelloController">

    <!-- =================================================================== -->
    <!-- CABECERA: Menú Superior y Barra de Herramientas                    -->
    <!-- =================================================================== -->
    <top>
        <VBox>
            <children>
                <MenuBar>
                    <Menu text="Archivo">
                        <items>
                            <MenuItem onAction="#onGuardar" text="Guardar" />
                            <SeparatorMenuItem />
                            <MenuItem onAction="#onSalir" text="Salir" />
                        </items>
                    </Menu>
                    <Menu text="Editar" />
                    <Menu text="Ayuda" />
                </MenuBar>
                <ToolBar>
                    <items>
                        <Button text="📄 Nuevo" />
                        <Button text="📤 Exportar" />
                        <Separator />
                        <Label text="Filtro:" />
                        <TextField promptText="Buscar registro..." />
                    </items>
                </ToolBar>
            </children>
        </VBox>
    </top>

    <!-- =================================================================== -->
    <!-- NAVEGACIÓN LATERAL                                                  -->
    <!-- =================================================================== -->
    <left>
        <VBox prefWidth="180.0" spacing="10.0" styleClass="sidebar">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label styleClass="sidebar-title" text="NAVEGACIÓN" />
                <Button maxWidth="Infinity" text="👥 Usuarios" />
                <Button maxWidth="Infinity" text="📊 Informes" />
                <Separator />
                <Button maxWidth="Infinity" text="⚙️ Ajustes" />
            </children>
        </VBox>
    </left>

    <!-- =================================================================== -->
    <!-- ÁREA CENTRAL: Pestañas con Formulario y Tabla                       -->
    <!-- =================================================================== -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <!-- Pestaña 1: Formulario -->
                <Tab text="Alta de Usuario">
                    <content>
                        <GridPane hgap="10.0" vgap="12.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <columnConstraints>
                                <ColumnConstraints minWidth="100.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                            </columnConstraints>
                            <children>
                                <Label styleClass="form-title" text="Registro de Nuevo Usuario" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="0" />

                                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Rol:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <ComboBox fx:id="cbRol" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                <Label text="Observaciones:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                <TextArea fx:id="txtBio" prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                <HBox alignment="CENTER_RIGHT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                                    <children>
                              <Button mnemonicParsing="false" style="-fx-background-color: red; -fx-font-weight: bold;" text="Eliminar" />
                                        <Button onAction="#onGuardar" styleClass="btn-success" text="Guardar" />
                                        <Button onAction="#onLimpiar" text="Limpiar" />
                                    </children>
                                </HBox>
                            </children>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                        </GridPane>
                    </content>
                </Tab>

                <!-- Pestaña 2: Listado -->
                <Tab text="Listado de Usuarios">
                    <content>
                        <TableView fx:id="tablaUsers">
                            <columns>
                                <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                                <TableColumn fx:id="colEmail" prefWidth="300.0" text="Email" />
                            </columns>
                        </TableView>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>

    <!-- =================================================================== -->
    <!-- BARRA DE ESTADO INFERIOR                                            -->
    <!-- =================================================================== -->
    <bottom>
        <HBox spacing="10.0" styleClass="status-bar">
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
            <children>
                <Label fx:id="lblStatus" text="🟢 Estado: Listo" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label text="v1.0.0 | Servidor: Conectado" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
